# ========================================
# GraphQL Movie API - Environment Config
# ========================================

# Node Environment
NODE_ENV=development
PORT=4000

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password@localhost:27017/movies?authSource=admin

# JWT Secrets (CHANGE THESE IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-prod
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-prod

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
