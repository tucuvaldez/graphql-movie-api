{
  "name": "graphql-movie-api",
  "version": "1.0.0",
  "description": "GraphQL Movie API - Portfolio Project",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "docker:build": "docker build -t graphql-movie-api .",
    "docker:up": "docker-compose up"
  },
  "keywords": [
    "graphql",
    "api",
    "movies",
    "apollo"
  ],
  "author": "Ricardo",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.9.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
